# LLM API Keys (at least one is required)
OPENAI_API_KEY=your_openai_api_key_here
ANTHROPIC_API_KEY=your_anthropic_api_key_here
GEMINI_API_KEY=your_gemini_api_key_here
# NVIDIA NIM (OpenAI-compatible). Alias: NVAPI_KEY
NVIDIA_API_KEY=nvapi-your_nvidia_api_key_here

# Search API (required in production)
SERPER_API_KEY=your_serper_api_key_here

# Server
PORT=3001
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000

# Database (required in production — use MongoDB Atlas URI)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/atom?appName=atom

# Redis (recommended in production for cache, BullMQ, and guest quotas)
# REDIS_URL=redis://localhost:6379

# Authentication (required in production)
CLERK_SECRET_KEY=your_clerk_secret_key_here

# Chat access (optional)
# REQUIRE_AUTH_FOR_CHAT=true
# GUEST_MESSAGE_LIMIT=2

# Cache TTLs (seconds, optional)
# CACHE_TTL_SEARCH=3600
# CACHE_TTL_SCRAPE=21600
# CACHE_TTL_QUERY=86400
# CACHE_TTL_ANSWER=3600
